# Copy this file to .env and fill in your values

# --- Admin login (protects /admin and /gellert/admin) ---
# Generate the hash with:  node scripts/hash-admin-password.mjs 'your-password'
# Without ADMIN_PASSWORD_HASH the admin is LOCKED in production and open locally.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=scrypt$...$...

# Signs the admin session cookie. Any long random string; changing it logs everyone out.
# Defaults to the password hash if unset.
SESSION_SECRET=

# Where editable content is stored. Production mounts this as a volume so admin
# changes survive redeploys; leave unset for local development.
# DATA_DIR=/app/data

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Agent auth secret (any random string, same in .env and used by agent)
AGENT_SECRET=change-me-to-a-random-string

# Server URL (change if deployed publicly)
SERVER_URL=http://localhost:3001

# Meta / Facebook Graph API
FB_PAGE_ACCESS_TOKEN=...
FB_PAGE_ID=...

# Instagram Business Account ID (linked to your Facebook Page)
IG_BUSINESS_ACCOUNT_ID=...
